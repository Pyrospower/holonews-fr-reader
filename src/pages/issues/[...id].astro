---
import IssueViewer from "$lib/components/IssueViewer.svelte";
import Layout from "$lib/layouts/Layout.astro";
import { PAGE_PARAM, STORAGE_KEYS } from "$lib/reader";
import { QUERY_PARAM } from "$lib/search";
import { getMentionIndex } from "$lib/talentMentions";
import type { PageTranscription } from "$lib/transcriptions";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const issues = await getCollection("issues");
  const transcriptionsByIssue = new Map<
    string,
    Record<number, PageTranscription>
  >();
  for (const { data } of await getCollection("transcriptions")) {
    const pages = transcriptionsByIssue.get(data.issueId) ?? {};
    // Only what the reader displays: the rest is serialized into the page
    pages[data.page] = { status: data.status, blocks: data.blocks };
    transcriptionsByIssue.set(data.issueId, pages);
  }
  // Talents of each page, computed here rather than in the browser
  const { pages } = await getMentionIndex();
  return issues.map((entry) => ({
    params: { id: entry.id },
    props: {
      entry,
      transcriptions: transcriptionsByIssue.get(entry.id) ?? {},
      talents: pages.get(entry.id) ?? {},
    },
  }));
}

const { entry, transcriptions, talents } = Astro.props;
---

<Layout title={entry.data.title}>
  <article class="prose mx-auto max-w-4xl">
    <h1 class="mb-4 text-2xl font-bold sm:text-4xl">{entry.data.title}</h1>
    <div class="mb-6 text-muted-foreground">
      {entry.data.tags?.map((tag: string) => (
        <span class="inline-flex items-center rounded-full border border-transparent bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground capitalize transition-colors select-none hover:bg-primary/80 focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:outline-none">
          {tag}
        </span>
      ))}
      <time datetime={entry.data.date.toISOString()}>
        {entry.data.date.toLocaleDateString("fr-FR", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    </div>
    <!--
      The viewer is prerendered on page 1 in Original mode, without a search.
      When the URL or the stored reading mode asks for something else, hide it
      until it has hydrated with the right state instead of flashing the
      default one. The animation shows it anyway if hydration never happens.
    -->
    <script
      is:inline
      define:vars={{
        modeKey: STORAGE_KEYS.mode,
        pageParam: PAGE_PARAM,
        queryParam: QUERY_PARAM,
      }}
    >
      let mode = null;
      try {
        mode = localStorage.getItem(modeKey);
      } catch {
        // Storage unavailable: default mode
      }
      const params = new URLSearchParams(location.search);
      const page = params.get(pageParam);
      if (
        (mode && mode !== "original") ||
        (page && page !== "1") ||
        params.get(queryParam)
      ) {
        document.documentElement.classList.add("reader-pending");
      }
    </script>
    <IssueViewer
      client:load
      issue={entry}
      transcriptions={transcriptions}
      talents={talents}
    />
  </article>
</Layout>

<style is:global>
  html.reader-pending [data-reader] {
    visibility: hidden;
    animation: reader-reveal 0s 3s forwards;
  }

  @keyframes reader-reveal {
    to {
      visibility: visible;
    }
  }
</style>
