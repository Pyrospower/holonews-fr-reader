---
import Layout from "$lib/layouts/Layout.astro";
import { getMentionIndex } from "$lib/talentMentions";
import { TALENT_DICTIONARY } from "$lib/talents";

const { talents } = await getMentionIndex();
const pageCounts = new Map(
  talents.map(({ talent, pageCount }) => [talent.slug, pageCount]),
);

// Branches and units of the dictionary, without the talents never mentioned
const branches = TALENT_DICTIONARY.branches
  .map((branch) => ({
    name: branch.name,
    units: branch.units
      .map((unit) => ({
        name: unit.name,
        talents: unit.talents.flatMap(({ slug, name }) => {
          const count = pageCounts.get(slug);
          return count ? [{ slug, name, count }] : [];
        }),
      }))
      .filter((unit) => unit.talents.length > 0),
  }))
  .filter((branch) => branch.units.length > 0);

const plural = (count: number, word: string) =>
  `${count} ${word}${count > 1 ? "s" : ""}`;
---

<Layout title="Talents">
  <div class="mx-auto max-w-5xl">
    <h1 class="mb-4 text-3xl font-bold md:text-4xl">Talents</h1>
    <p class="mb-8 max-w-3xl leading-relaxed text-muted-foreground">
      Les {talents.length} talents cités dans les transcriptions des numéros,
      avec le nombre de pages qui les mentionnent. Les mentions sont repérées
      automatiquement à partir de leurs noms et surnoms : il peut en manquer, ou
      s'en glisser une de trop.
    </p>

    {branches.map((branch, index) => (
      <section class="mb-10" aria-labelledby={`branch-${index}`}>
        <h2
          id={`branch-${index}`}
          class="mb-4 border-b pb-2 text-2xl font-semibold"
        >
          {branch.name}
        </h2>
        {branch.units.map((unit) => (
          <div class="mb-6">
            <h3 class="mb-3 text-lg font-medium">{unit.name}</h3>
            <ul class="grid grid-cols-1 gap-3 min-[420px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {unit.talents.map((talent) => (
                <li>
                  <a
                    href={`/talents/${talent.slug}`}
                    class="group flex h-full items-baseline justify-between gap-3 rounded-xl bg-card px-4 py-3 text-card-foreground ring-1 ring-foreground/10 transition-colors outline-none hover:bg-muted/50 focus-visible:ring-3 focus-visible:ring-ring/50"
                  >
                    <span class="font-medium group-hover:underline">
                      {talent.name}
                    </span>
                    <span class="shrink-0 text-sm text-muted-foreground tabular-nums">
                      {plural(talent.count, "page")}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>
</Layout>
