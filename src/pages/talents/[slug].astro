---
import HighlightedText from "$lib/components/HighlightedText.svelte";
import Layout from "$lib/layouts/Layout.astro";
import { PAGE_PARAM } from "$lib/reader";
import { QUERY_PARAM } from "$lib/search";
import { getMentionIndex, type TalentMentions } from "$lib/talentMentions";

export async function getStaticPaths() {
  const { talents } = await getMentionIndex();
  return talents.map((mentions) => ({
    params: { slug: mentions.talent.slug },
    props: { mentions },
  }));
}

interface Props {
  mentions: TalentMentions;
}

const { talent, issues, pageCount } = Astro.props.mentions;

const plural = (count: number, word: string) =>
  `${count} ${word}${count > 1 ? "s" : ""}`;

function readerUrl(issueId: string, page: number, query: string) {
  const params = new URLSearchParams({
    [PAGE_PARAM]: String(page),
    [QUERY_PARAM]: query,
  });
  return `/issues/${issueId}?${params}`;
}

function formatDate(date: Date) {
  return date.toLocaleDateString("fr-FR", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout title={talent.name}>
  <div class="mx-auto max-w-3xl">
    <a
      href="/talents"
      class="mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground hover:underline"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      Tous les talents
    </a>
    <h1 class="mb-2 text-3xl font-bold md:text-4xl">{talent.name}</h1>
    <p class="mb-2 text-muted-foreground">
      {talent.branch} · {talent.unit}
    </p>
    <p class="mb-8 font-medium">
      Mentions : {plural(pageCount, "page")} dans{" "}
      {plural(issues.length, "numéro")}
    </p>

    {issues.map(({ issue, pages }) => (
      <section class="mb-8">
        <h2 class="text-xl font-semibold">
          <a
            href={`/issues/${issue.id}`}
            class="underline-offset-2 hover:underline"
          >
            {issue.data.title}
          </a>
        </h2>
        <p class="mb-3 text-sm text-muted-foreground">
          <time datetime={issue.data.date.toISOString()}>
            {formatDate(issue.data.date)}
          </time>
        </p>
        <ol class="space-y-3">
          {pages.map(({ page, excerpt, query }) => (
            <li>
              <a
                href={readerUrl(issue.id, page, query)}
                class="group block rounded-xl bg-card px-4 py-3 text-card-foreground ring-1 ring-foreground/10 transition-colors outline-none hover:bg-muted/50 focus-visible:ring-3 focus-visible:ring-ring/50"
              >
                <span class="font-medium group-hover:underline">
                  Page {page}
                  <span class="sr-only">de {issue.data.title}</span>
                </span>
                <span class="mt-1.5 block text-sm leading-relaxed text-muted-foreground">
                  <HighlightedText segments={excerpt} />
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>
